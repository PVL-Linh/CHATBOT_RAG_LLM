{$DOMAIN} {
    encode zstd gzip

    reverse_proxy app:8000 {
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
        header_up X-Forwarded-Port {server_port}
    }

    log {
        output stdout
        format console
        level INFO
    }
}
